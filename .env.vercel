# ==============================================================================
# RiveraGPT — Production Environment Variables for Vercel Deployment
# ==============================================================================
# Copy and paste these keys into:
# Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# ==============================================================================

# 1. Primary AI Intelligence & Multimodal (Google AI Studio)
# Obtain free from: https://aistudio.google.com/api-keys
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Multi-Model OpenRouter (Claude 3.5 Sonnet, GPT-4o, DeepSeek R1)
# Obtain from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. Hugging Face Inference & Open Weights (Qwen 2.5, DeepSeek R1, Llama 3.3)
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGINGFACE_API_KEY=

# 4. Live Weather & Forecasts (WeatherAPI.com)
# Obtain free from: https://www.weatherapi.com/my/
WEATHERAPI_KEY=
# Fallback provider: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# 5. Live News & Real-Time Research (GNews)
# Obtain free from: https://gnews.io/dashboard
GNEWS_API_KEY=

# 6. Job Search Integration (Adzuna)
# Obtain free from: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# 7. Navigation & Directions (OpenRouteService / HeiGIT)
# Obtain free from: https://account.heigit.org/manage/key
HEIGIT_API_KEY=
OPENROUTESERVICE_API_KEY=

# 8. Web Search (Tavily optional)
TAVILY_API_KEY=
